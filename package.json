{
  "name": "my-portfolio-mcp",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "start": "bun src/index.ts",
    "postinstall": "node_modules/.bin/playwright install chromium",
    "check": "tsc --noEmit && eslint src/ && prettier --check src/",
    "check:fix": "eslint src/ --fix && prettier --write src/",
    "test": "bun test src/__tests__/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@supabase/supabase-js": "^2.99.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "express": "^5.1.0",
    "jose": "^6.0.11",
    "openai": "^6.27.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.58.2",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.34.5",
    "winston": "^3.19.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.3",
    "@types/winston": "^2.4.4",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.57.0"
  }
}
