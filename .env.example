# Server
PORT=3001
MCP_SERVER_URL=http://localhost:3001

# Auth Provider: "keycloak" or "clerk"
AUTH_PROVIDER=keycloak

# Keycloak (required if AUTH_PROVIDER=keycloak)
KEYCLOAK_ISSUER=http://localhost:8080/realms/mcp

# Clerk (required if AUTH_PROVIDER=clerk)
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_SECRET_KEY=sk_test_...

# OpenAI (required for AI-powered tools)
OPENAI_API_KEY=sk-your-key-here
# AI_MODEL=gpt-4o-mini

# NewsAPI (optional — needed for news tools)
# Get a free key at https://newsapi.org/register
# NEWS_API_KEY=your_newsapi_key

# Supabase Storage (optional — files fall back to local storage if not set)
# Create a project at https://supabase.com, then Storage → New bucket (public)
# Keys at: Project Settings → API Keys
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_BUCKET=MCP Server Output
